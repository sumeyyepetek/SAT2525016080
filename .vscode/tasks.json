{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "BlazorApp: Derle",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/BlazorApp/BlazorApp.csproj",
                "--configuration",
                "Debug",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
       
    ]
}
